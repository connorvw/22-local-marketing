---
import '../styles/global.css';
import QuoteForm from '../components/QuoteForm.astro';

const systems = [
  ['01', 'Google Business Profile', 'The profile work, reviews, categories, and local signals that help you show up when nearby homeowners need tree work.'],
  ['02', 'Website and local SEO', 'A fast site with useful service and location pages, built around real photos and the searches that matter in your market.'],
  ['03', 'Google Ads and LSA', 'High-intent campaigns that create calls while organic visibility builds, with call tracking and practical budget controls.'],
  ['04', 'Meta Ads', 'Local creative that keeps your company visible, builds familiarity, and creates another source of estimate requests.'],
  ['05', 'Lead follow-up', 'Forms, call tracking, and follow-up workflows that help your team respond before a good lead goes cold.'],
  ['06', 'Reporting tied to leads', 'Clear monthly reporting on calls, forms, cost per lead, and the work completed, without a tour of vanity metrics.'],
];

const faqs = [
  ['Do you work with tree service companies?', 'Yes. Tree care and related land services are where our systems and experience are deepest. We will review your market and current setup before recommending a plan.'],
  ['How quickly can paid ads start producing leads?', 'Paid campaigns can create calls sooner than SEO, but timing depends on your market, budget, offer, and account history. We set expectations after reviewing the local competition and existing data.'],
  ['Do I pay ad spend separately?', 'Yes. Your ad spend is paid directly to the advertising platforms. Management, creative, tracking, website work, and other services are scoped separately in your plan.'],
  ['Can you work with our existing website or ad accounts?', 'Usually. We audit what is already working, preserve useful history, and recommend only the changes that have a clear reason behind them.'],
  ['What happens on the strategy call?', 'We review your market, current lead sources, website, Google presence, and advertising. You leave with a short list of the clearest opportunities, even if we are not the right fit.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Marketing for Tree Service Companies | 22 Local Marketing</title>
    <meta name="description" content="A connected marketing system for tree service companies, including Google Ads, local SEO, websites, Meta Ads, reviews, and lead tracking." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://grow.22localmarketing.com/" />
    <meta property="og:title" content="Stop Renting Leads | 22 Local Marketing" />
    <meta property="og:description" content="Build a connected marketing system that creates direct calls and strengthens assets your tree service company owns." />
    <meta property="og:url" content="https://grow.22localmarketing.com/" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script async src="https://aromatic-caribou-889.convex.site/api/a/am_z8jL6jvgnKBNlcJA"></script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KQHQD9R8');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="grow-page">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KQHQD9R8"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <nav class="grow-nav">
      <div class="wrap nav-inner">
        <a href="/" aria-label="22 Local Marketing home"><img src="/22lm-logo.png" alt="22 Local Marketing" /></a>
        <a class="button button-small" href="#strategy">Free strategy call <span>→</span></a>
      </div>
    </nav>

    <main>
      <header class="hero">
        <div class="hero-grid"></div>
        <div class="wrap hero-inner">
          <div class="eyebrow">One team for every growth channel</div>
          <h1>Stop renting leads. Build a marketing system <em>you own.</em></h1>
          <p class="hero-copy">Get one accountable team for your website, Google Ads, Local Services Ads, SEO, Google Business Profile, Meta Ads, tracking, and follow-up. No more coordinating vendors. No more competing for shared leads.</p>

          <div class="video-shell" id="overview">
            <div class="video-bar">
              <span class="live-dot"></span>
              <span>Watch the short overview</span>
              <span class="video-time">About 1 minute</span>
            </div>
            <iframe
              src="https://www.tella.tv/video/vid_cmt96ym8x01j804jw0itbcc54/embed?b=0&amp;title=0&amp;a=0&amp;loop=0&amp;t=0&amp;muted=0&amp;wt=0"
              title="Marketing for tree and land companies"
              allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
              allowfullscreen></iframe>
          </div>

          <div class="hero-actions">
            <a class="button button-hero" href="#strategy">Book a free strategy call <span>→</span></a>
          </div>
          <div class="micro-trust hero-trust"><span>One accountable team</span><span>Direct leads to your company</span><span>Assets you keep</span></div>

        </div>
      </header>

      <section class="proof-strip" aria-label="Selected client results">
        <div class="wrap proof-grid">
          <div class="stat"><span class="stat-label">Phone calls</span><strong>60+</strong><span>Per client each month, across Google, ads, and search</span></div>
          <div class="stat"><span class="stat-label">Form leads</span><strong>40+</strong><span>Web form submissions per client, every month</span></div>
          <div class="stat"><span class="stat-label">Cost per lead</span><strong>&lt;$50</strong><span>From all sources combined, paid and organic</span></div>
          <div class="stat"><span class="stat-label">Google reviews</span><strong>5.0★</strong><span>Average rating across our clients' profiles</span></div>
        </div>
      </section>

      <section class="problem section-pad">
        <div class="wrap narrow">
          <div class="section-label">You did not build a tree company to chase shared leads</div>
          <h2>The work is hard enough. Getting the next estimate should not feel like a race to the bottom.</h2>
          <div class="problem-grid">
            <article><span>01</span><h3>Shared leads reward speed, not trust.</h3><p>The homeowner fills out one form and several companies start calling. You paid for access, but you never owned the relationship.</p></article>
            <article><span>02</span><h3>The phone is inconsistent.</h3><p>A busy month hides the gaps. Then demand slows and there is no dependable system creating the next estimate.</p></article>
            <article><span>03</span><h3>Your marketing never compounds.</h3><p>When you stop buying marketplace leads, the leads stop. There is no stronger website, better local presence, or growing audience left behind.</p></article>
          </div>
        </div>
      </section>

      <section class="ownership section-pad">
        <div class="wrap ownership-grid">
          <div class="ownership-intro">
            <div class="section-label light">Renting attention versus building equity</div>
            <h2>Every marketing dollar should leave you with something stronger.</h2>
            <p>Paid ads can create demand now. SEO, reviews, a useful website, customer data, and good follow-up make that demand more valuable over time. The point is not to avoid paid traffic. The point is to stop depending on a marketplace that owns the customer and sells the same opportunity again.</p>
          </div>
          <div class="choice-grid">
            <article class="choice-card rent">
              <span class="choice-label">Rent the lead</span>
              <h3>Marketplace dependency</h3>
              <ul><li>The same lead goes to multiple companies</li><li>You compete before trust is established</li><li>The platform owns the audience</li><li>Stop paying and the pipeline disappears</li></ul>
            </article>
            <article class="choice-card own">
              <span class="choice-label">Own the system</span>
              <h3>Your local demand engine</h3>
              <ul><li>Homeowners contact your company directly</li><li>Your reviews and reputation do the selling</li><li>You keep your data and campaign history</li><li>Each channel strengthens the others</li></ul>
            </article>
          </div>
        </div>
      </section>

      <section class="case-study section-pad">
        <div class="wrap case-grid">
          <div class="case-copy">
            <div class="section-label light">A current campaign example</div>
            <h2>From limited visibility to a real organic lead channel.</h2>
            <p>A newer land management company in Northwest Ohio had almost no search presence. We built the site, developed its service coverage, and strengthened its Google presence.</p>
            <p>Within six months, the business appeared for more than 1,000 search queries and held more than 160 keywords in Google’s top three.</p>
            <div class="case-note">Results vary by market, competition, budget, and starting position. These figures describe one active client campaign.</div>
          </div>
          <div class="case-card" aria-label="Case study metrics">
            <div class="case-card-top"><span>6-month snapshot</span><span>Northwest Ohio</span></div>
            <div class="case-metric"><strong>17K+</strong><span>Google impressions<br />in a 90-day window</span></div>
            <div class="case-pair">
              <div><strong>1,000+</strong><span>queries ranking</span></div>
              <div><strong>160+</strong><span>top-three rankings</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="reviews section-pad">
        <div class="wrap">
          <div class="approved-head">
            <h2>What owners actually say.</h2>
            <p>Real reviews from owners we work with every week.</p>
          </div>
          <div class="review-grid">
            <article class="review-card"><div class="stars">★★★★★</div><p>“Connor is the man. Very responsive and he knows his stuff. He has helped my business grow more than I ever imagined.”</p><div class="review-author"><span>BF</span><div><strong>Brice Fonville</strong><small>Verified Google review</small></div></div></article>
            <article class="review-card"><div class="stars">★★★★★</div><p>“Super service, very easy to work with. Connor is very knowledgeable, patient and best of all isn't trying to push services you don't need.”</p><div class="review-author"><span>RR</span><div><strong>Robert Rangel</strong><small>Verified Google review</small></div></div></article>
            <article class="review-card"><div class="stars">★★★★★</div><p>“Connor's attention to detail and constant communication have made him a joy to work with. I am extremely happy with the work he has done.”</p><div class="review-author"><span>DS</span><div><strong>Dawn Sulflow</strong><small>Verified Google review</small></div></div></article>
          </div>
        </div>
      </section>

      <section class="system section-pad">
        <div class="wrap">
          <div class="section-label">Your guide and the plan</div>
          <div class="section-head">
            <h2>The Compound Presence Method puts your company everywhere the decision happens.</h2>
            <p>You already know how to run the crew and serve the customer. Our job is to connect the marketing channels, track what creates calls, and give you a clear plan for improving them.</p>
          </div>
          <div class="system-grid">
            {systems.map(([number, title, copy]) => (
              <article class="system-card"><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="plan section-pad">
        <div class="wrap plan-grid">
          <div>
            <div class="section-label light">A practical working relationship</div>
            <h2>A clear path from scattered marketing to an owned lead system.</h2>
          </div>
          <div class="plan-steps">
            <div><span>01</span><p><strong>See the gaps.</strong> We review the site, GBP, ads, reviews, tracking, and local competition.</p></div>
            <div><span>02</span><p><strong>Choose the target.</strong> We agree on the calls, leads, acquisition cost, and market visibility that matter.</p></div>
            <div><span>03</span><p><strong>Build the system.</strong> Website, SEO, GBP, paid media, creative, and follow-up support one another.</p></div>
            <div><span>04</span><p><strong>Improve what you own.</strong> We track the results, move budget with the data, and keep strengthening the assets.</p></div>
          </div>
        </div>
      </section>

      <section class="faq section-pad">
        <div class="wrap faq-wrap">
          <div class="section-label">Questions tree service owners ask</div>
          <h2>Clear answers before you make a decision.</h2>
          <div class="faq-list">
            {faqs.map(([question, answer], index) => (
              <details open={index === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>
            ))}
          </div>
        </div>
      </section>

      <section class="strategy section-pad" id="strategy">
        <div class="wrap strategy-grid">
          <div class="strategy-copy">
            <div class="section-label light">Free strategy call</div>
            <h2>Find the gaps costing you direct calls.</h2>
            <p>We will review your current presence, local competition, and lead flow before the call. You will see where leads are leaking, which channels deserve attention first, and what your company should own. If there is not a sensible fit, we will say so.</p>
            <ul><li>Website and conversion review</li><li>Google and paid-channel review</li><li>Local competitor snapshot</li><li>Prioritized next steps</li></ul>
          </div>
          <div class="form-wrap"><QuoteForm eyebrow="No-cost market review" title="Tell us about your market" description="Share the basics. We will review your current setup before the call." submitLabel="Request my strategy call" /></div>
        </div>
      </section>
    </main>

    <footer class="grow-footer">
      <div class="wrap footer-inner"><img src="/22lm-logo.png" alt="22 Local Marketing" /><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><span>© 2026 22 Local Marketing</span></div></div>
    </footer>

    <script is:inline>
      document.querySelectorAll('.faq details').forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          document.querySelectorAll('.faq details').forEach((other) => {
            if (other !== item) other.removeAttribute('open');
          });
        });
      });
    </script>
  </body>
</html>

<style>
  :global(body.grow-page) { --orange:#fb5607; --ink:#101010; --cream:#f6f2e9; --paper:#fffdf8; --line:#d8d1c4; margin:0; color:var(--ink); background:var(--paper); font-family:'Bai Jamjuree',sans-serif; }
  :global(.grow-page *) { box-sizing:border-box; }
  .wrap { width:min(1180px, calc(100% - 48px)); margin-inline:auto; }
  .narrow { width:min(1000px, calc(100% - 48px)); }
  .section-pad { padding:110px 0; }
  .grow-nav { position:absolute; inset:0 0 auto; z-index:10; border-bottom:1px solid rgba(255,255,255,.16); }
  .nav-inner { height:82px; display:flex; justify-content:space-between; align-items:center; }
  .nav-inner img,.grow-footer img { width:205px; height:auto; filter:brightness(0) invert(1); display:block; }
  .button { min-height:52px; display:inline-flex; align-items:center; justify-content:center; gap:18px; padding:0 24px; background:var(--orange); color:#fff; text-decoration:none; font-weight:700; border:1px solid var(--orange); border-radius:3px; box-shadow:5px 5px 0 rgba(0,0,0,.28); transition:transform .18s,box-shadow .18s; }
  .button:hover { transform:translate(-2px,-2px); box-shadow:8px 8px 0 rgba(0,0,0,.32); }
  .button-small { min-height:44px; padding:0 18px; font-size:.94rem; box-shadow:none; }
  .hero { min-height:860px; position:relative; overflow:hidden; color:#fff; background:radial-gradient(circle at 78% 20%,rgba(251,86,7,.28),transparent 30%),linear-gradient(135deg,#0b0b0b 0%,#181818 62%,#0c0c0c 100%); padding:150px 0 90px; }
  .hero::after { content:''; position:absolute; width:520px; height:520px; right:-180px; bottom:-260px; border:70px solid rgba(251,86,7,.14); transform:rotate(18deg); }
  .hero-grid { position:absolute; inset:0; opacity:.055; background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px); background-size:54px 54px; mask-image:linear-gradient(to bottom,#000,transparent 88%); }
  .hero-inner { position:relative; z-index:1; text-align:center; display:flex; align-items:center; flex-direction:column; }
  .eyebrow,.section-label { display:flex; align-items:center; gap:12px; color:var(--orange); text-transform:uppercase; letter-spacing:.13em; font-size:.9rem; font-weight:700; }
  .eyebrow span { width:32px; height:2px; background:var(--orange); }
  h1,h2,h3 { font-family:'Teko',sans-serif; margin:0; }
  h1 { max-width:930px; margin:24px auto 14px; font-size:clamp(4rem,8vw,7.3rem); line-height:.83; letter-spacing:-.025em; text-transform:uppercase; font-weight:600; }
  h1 em,h2 em { color:var(--orange); font-style:normal; }
  .hero-copy { max-width:720px; font-size:1.2rem; line-height:1.6; color:#d1d1d1; margin:0 auto 34px; }
  .video-shell { width:min(810px,100%); background:#080808; border:1px solid #3b3b3b; box-shadow:16px 18px 0 rgba(251,86,7,.25); text-align:left; }
  .video-bar { min-height:42px; display:flex; align-items:center; gap:10px; padding:0 15px; color:#cfcfcf; font-size:.9rem; border-bottom:1px solid #303030; }
  .live-dot { width:8px; height:8px; border-radius:50%; background:var(--orange); box-shadow:0 0 0 5px rgba(251,86,7,.12); }
  .video-time { margin-left:auto; color:#8d8d8d; }
  .video-shell iframe { width:100%; aspect-ratio:16/9; border:0; display:block; background:#000; }
  .button-hero { margin-top:34px; min-width:310px; }
  .micro-trust { display:flex; flex-wrap:wrap; justify-content:center; gap:10px 28px; margin-top:20px; color:#aaa; font-size:.9rem; }
  .micro-trust span::before { content:'✓'; color:var(--orange); margin-right:7px; }
  .proof-strip { background:var(--orange); color:#fff; }
  .proof-grid { display:grid; grid-template-columns:repeat(4,1fr); }
  .proof-grid div { padding:30px 24px; border-right:1px solid rgba(255,255,255,.28); display:flex; flex-direction:column; }
  .proof-grid div:last-child { border:0; }
  .proof-grid strong { font-family:'Teko'; font-size:3.2rem; line-height:1; }
  .proof-grid span { font-size:.9rem; line-height:1.3; }
  .section-label { margin-bottom:20px; }
  .section-label.light { color:#ff7a38; }
  .problem h2,.faq h2 { font-size:clamp(3.2rem,6vw,5.2rem); line-height:.92; max-width:850px; letter-spacing:-.02em; text-transform:uppercase; }
  .problem-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:54px; }
  .problem-grid article { border-top:4px solid var(--ink); padding:28px 4px 0; }
  .problem-grid article>span,.system-card>span { color:var(--orange); font-weight:700; }
  .problem-grid h3 { font-size:2rem; line-height:1; margin:17px 0 10px; text-transform:uppercase; }
  .problem-grid p,.system-card p,.section-head p,.faq p { color:#5c5a56; line-height:1.65; margin:0; }
  .case-study { color:#fff; background:linear-gradient(145deg,#101010,#232323); position:relative; overflow:hidden; }
  .case-study::after { content:'RESULTS'; position:absolute; right:-20px; bottom:-80px; font:600 14rem/1 'Teko'; color:rgba(255,255,255,.025); }
  .case-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:80px; align-items:center; position:relative; z-index:1; }
  .case-copy h2,.plan h2,.strategy h2 { font-size:clamp(3.3rem,6vw,5.6rem); line-height:.9; text-transform:uppercase; }
  .case-copy>p { font-size:1.06rem; line-height:1.7; color:#c5c5c5; max-width:610px; }
  .case-note { border-left:3px solid var(--orange); padding-left:15px; margin-top:28px; color:#929292; font-size:.9rem; line-height:1.5; }
  .case-card { background:var(--paper); color:var(--ink); border-radius:4px; padding:30px; box-shadow:12px 12px 0 var(--orange); transform:rotate(1deg); }
  .case-card-top { display:flex; justify-content:space-between; padding-bottom:20px; border-bottom:1px solid var(--line); text-transform:uppercase; letter-spacing:.08em; font-size:.85rem; font-weight:700; }
  .case-metric { padding:34px 0; display:flex; align-items:end; gap:20px; }
  .case-metric strong { font:600 6.8rem/.75 'Teko'; color:var(--orange); }
  .case-metric span { font-size:1rem; line-height:1.4; }
  .case-pair { display:grid; grid-template-columns:1fr 1fr; border-top:1px solid var(--line); }
  .case-pair>div { padding-top:24px; }
  .case-pair>div+div { border-left:1px solid var(--line); padding-left:24px; }
  .case-pair strong { display:block; font:600 3rem/1 'Teko'; }
  .case-pair span { color:#67635e; }
  .ownership { background:var(--orange); color:#fff; }
  .ownership-grid { display:grid; grid-template-columns:.82fr 1.18fr; gap:70px; align-items:center; }
  .ownership-intro h2 { font-size:clamp(3.4rem,6vw,5.7rem); line-height:.88; text-transform:uppercase; }
  .ownership-intro p { font-size:1.04rem; line-height:1.7; color:#fff4ed; }
  .choice-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .choice-card { min-height:430px; padding:30px; border:1px solid rgba(255,255,255,.55); position:relative; overflow:hidden; }
  .choice-card.rent { background:#2a211d; color:#d8cec8; transform:rotate(-1deg); }
  .choice-card.own { background:var(--paper); color:var(--ink); box-shadow:9px 9px 0 #111; transform:rotate(1deg); }
  .choice-label { display:inline-block; padding:6px 9px; border:1px solid currentColor; text-transform:uppercase; letter-spacing:.1em; font-size:.78rem; font-weight:700; }
  .choice-card h3 { font-size:2.5rem; line-height:.95; text-transform:uppercase; margin:28px 0; }
  .choice-card ul { list-style:none; padding:0; margin:0; }
  .choice-card li { padding:15px 0 15px 27px; border-top:1px solid rgba(128,128,128,.35); line-height:1.45; position:relative; }
  .choice-card li::before { content:'×'; position:absolute; left:2px; color:#ad8170; font-weight:700; font-size:1.2rem; }
  .choice-card.own li::before { content:'✓'; color:var(--orange); }
  .system { background:var(--cream); }
  .section-head { display:grid; grid-template-columns:1.2fr .8fr; gap:70px; align-items:end; margin-bottom:50px; }
  .section-head h2 { font-size:clamp(3.4rem,6vw,5.5rem); line-height:.9; text-transform:uppercase; }
  .section-head p { font-size:1.04rem; }
  .system-grid { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid var(--ink); }
  .system-card { min-height:260px; padding:30px; border-right:1px solid var(--ink); border-bottom:1px solid var(--ink); background:var(--paper); transition:background .2s,transform .2s; }
  .system-card:nth-child(3n) { border-right:0; }
  .system-card:nth-last-child(-n+3) { border-bottom:0; }
  .system-card:hover { background:#fff; transform:translateY(-5px); }
  .system-card h3 { font-size:2.2rem; line-height:1; text-transform:uppercase; margin:26px 0 10px; }
  .plan { background:var(--orange); color:#fff; }
  .plan-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:90px; align-items:start; }
  .plan-steps { border-top:1px solid rgba(255,255,255,.4); }
  .plan-steps>div { display:grid; grid-template-columns:58px 1fr; padding:24px 0; border-bottom:1px solid rgba(255,255,255,.4); }
  .plan-steps span { font-weight:700; }
  .plan-steps p { margin:0; line-height:1.55; }
  .faq-wrap { max-width:900px; }
  .faq h2 { margin-bottom:42px; }
  .faq-list { border-top:2px solid var(--ink); }
  .faq details { border-bottom:1px solid var(--line); }
  .faq summary { list-style:none; cursor:pointer; display:flex; justify-content:space-between; gap:20px; padding:24px 0; font-weight:700; font-size:1.08rem; }
  .faq summary::-webkit-details-marker { display:none; }
  .faq summary span { color:var(--orange); font-size:1.6rem; line-height:.8; transition:transform .2s; }
