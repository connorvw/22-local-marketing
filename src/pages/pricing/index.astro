---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
---

<BaseLayout title="Pricing | 22 Local Marketing" description="Three service plans for tree and land companies, with clear scope across websites, SEO, Google Business Profile, paid advertising, CRM, and reporting.">

<header class="page-hero">
  <div class="container">
    <div class="eyebrow-rugged">
      <span class="eb-dash"></span>
      <span>PRICING</span>
    </div>
    <div class="hero-frame">
      <h1>Three plans. <span class="accent">Clear scope.</span></h1>
    </div>
    <p class="lead">Choose the level of service that matches the work your business needs. Advertising spend is billed separately and paid directly to the advertising platforms.</p>
  </div>
</header>

<section class="container">
  <div class="pricing-cards">
    <div class="plan">
      <div class="plan-name">Launch</div>
      <div class="plan-headline">Start generating leads.</div>
      <div class="plan-price"><span class="amt">$1,250</span><span class="per">/ month</span></div>
      <div class="plan-blurb">A focused local marketing system with a one-page website, Meta campaigns, and lead follow-up for businesses ready to generate new opportunities.</div>
      <ul class="plan-included">
        <li>Meta Ads management</li>
        <li>One-page website</li>
        <li>Dedicated campaign landing pages</li>
        <li>Google Business Profile management</li>
        <li>One primary offer and market</li>
        <li>CRM and sales pipeline</li>
        <li>Basic lead follow-up automation</li>
        <li>Call and form tracking</li>
        <li>Monthly reporting</li>
      </ul>
      <a href="/#contact" class="plan-cta" data-quote>Get started <span class="btn-arrow">→</span></a>
    </div>

    <div class="plan featured">
      <div class="plan-tag">Most popular</div>
      <div class="plan-name">Growth</div>
      <div class="plan-headline">Build the full marketing engine.</div>
      <div class="plan-price"><span class="amt">$2,000</span><span class="per">/ month</span></div>
      <div class="plan-blurb">Everything in Launch, plus the website, search channels, and local visibility needed for a complete system.</div>
      <ul class="plan-included">
        <li>Everything in Launch</li>
        <li>Full custom multi-page website</li>
        <li>Hosting and maintenance</li>
        <li>Google Search Ads management</li>
        <li>Local Services Ads management</li>
        <li>Local and technical SEO</li>
        <li>Expanded CRM and reporting</li>
      </ul>
      <a href="/#contact" class="plan-cta" data-quote>Get started <span class="btn-arrow">→</span></a>
    </div>

    <div class="plan">
      <div class="plan-name">Scale</div>
      <div class="plan-headline">Expand and protect your market.</div>
      <div class="plan-price"><span class="amt">$3,000+</span><span class="per">/ month</span></div>
      <div class="plan-blurb">Everything in Growth, with greater capacity, deeper production, and category exclusivity in an agreed territory.</div>
      <ul class="plan-included">
        <li>Everything in Growth</li>
        <li>Category exclusivity in an agreed territory</li>
        <li>Additional markets, services, or campaigns</li>
        <li>Expanded landing page capacity</li>
        <li>Ongoing creative testing</li>
        <li>Video editing from client-provided footage</li>
        <li>Lead and database reactivation</li>
        <li>Expanded SEO, content, and CRM automation</li>
        <li>Priority turnaround and deeper strategy</li>
      </ul>
      <a href="/#contact" class="plan-cta" data-quote>Get started <span class="btn-arrow">→</span></a>
    </div>
  </div>
</section>

<section class="compare-section">
  <div class="container">
    <div class="compare-head">
      <h2>Full feature breakdown.</h2>
      <span class="desc">A clear line between each level of service.</span>
    </div>
    <div class="table-scroll">
      <table class="compare-table">
        <thead><tr>
          <th>Service</th>
          <th class="plan-th">Launch<span class="plan-th-price">$1,250</span></th>
          <th class="plan-th featured-col">Growth<span class="plan-th-price">$2,000</span></th>
          <th class="plan-th">Scale<span class="plan-th-price">$3,000+</span></th>
        </tr></thead>
        <tbody>
          <tr class="section-row"><td colspan="4">Lead generation</td></tr>
          <tr><td class="feature-name">Meta Ads management</td><td class="plan-cell"><span class="check">✓</span></td><td class="plan-cell featured-cell"><span class="check">✓</span></td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Google Search Ads management</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell"><span class="check">✓</span></td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Local Services Ads management</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell"><span class="check">✓</span></td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Campaign landing pages</td><td class="plan-cell">Included for active campaigns</td><td class="plan-cell featured-cell">Included for active campaigns</td><td class="plan-cell">Expanded capacity</td></tr>
          <tr class="section-row"><td colspan="4">Owned marketing foundation</td></tr>
          <tr><td class="feature-name">Website, hosting, and maintenance</td><td class="plan-cell">One-page website</td><td class="plan-cell featured-cell">Full custom multi-page website</td><td class="plan-cell">Full custom multi-page website</td></tr>
          <tr><td class="feature-name">Google Business Profile management</td><td class="plan-cell"><span class="check">✓</span></td><td class="plan-cell featured-cell"><span class="check">✓</span></td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Local and technical SEO</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell"><span class="check">✓</span></td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr class="section-row"><td colspan="4">Systems and scale</td></tr>
          <tr><td class="feature-name">CRM and lead follow-up</td><td class="plan-cell">Basic</td><td class="plan-cell featured-cell">Expanded</td><td class="plan-cell">Custom automation</td></tr>
          <tr><td class="feature-name">Tracking and reporting</td><td class="plan-cell">Monthly</td><td class="plan-cell featured-cell">Expanded</td><td class="plan-cell">Expanded revenue attribution</td></tr>
          <tr><td class="feature-name">Additional markets, services, or campaigns</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell">Not included</td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Creative testing and video editing</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell">Not included</td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Lead and database reactivation</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell">Not included</td><td class="plan-cell"><span class="check">✓</span></td></tr>
          <tr><td class="feature-name">Category exclusivity in an agreed territory</td><td class="plan-cell">Not included</td><td class="plan-cell featured-cell">Not included</td><td class="plan-cell"><span class="check">✓</span></td></tr>
        </tbody>
      </table>
    </div>
    <div class="ad-note">
      <h3>Setup and ad spend.</h3>
      <p>The setup fee is <strong>$1,250</strong>. We waive it when you choose an initial six-month commitment. Otherwise, service begins month-to-month. After the initial term, service becomes month-to-month. Advertising spend is separate from the management fee and is paid directly to the advertising platforms.</p>
    </div>
  </div>
</section>

<section class="timeline-section">
  <div class="container">
    <div class="timeline-head">
      <h2>Honest timeline expectations.</h2>
      <p class="desc">Paid channels can move sooner. Local and organic visibility build over time.</p>
    </div>
    <div class="timeline-grid">
      <div class="tl-card"><div class="tl-when">Months 1 to 3</div><div class="tl-title">Build and launch.</div><div class="tl-body">The website, tracking, Google Business Profile, reporting, and initial search foundation are put in place. Growth and Scale can begin paid acquisition during this period.</div></div>
      <div class="tl-card"><div class="tl-when">Months 3 to 6</div><div class="tl-title">Refine what is working.</div><div class="tl-body">Search data, calls, and lead quality give us a clearer view of what to expand, fix, or stop. Local and organic visibility should begin showing more useful movement.</div></div>
      <div class="tl-card"><div class="tl-when">Months 6 to 12+</div><div class="tl-title">Compound the useful channels.</div><div class="tl-body">The goal is a healthier mix of paid, local, and organic demand, with clearer reporting on which work is producing calls and booked jobs.</div></div>
    </div>
  </div>
</section>

<section class="page-cta">
  <div class="container">
    <div class="page-cta-grid">
      <div>
        <div class="page-cta-eyebrow">→ Pick the right tier</div>
        <h2>Not sure which plan?<br>That's what the call is for.</h2>
        <p>15 minutes. We'll look at your current rankings, your competitors, and your goals. Then we'll tell you straight which tier fits.</p>
      </div>
      <QuoteForm />
    </div>
  </div>
</section>

<style is:global>
.page-hero { padding: 88px 0 56px; }
.page-hero .eyebrow-rugged { display: flex; }
.page-hero .hero-frame { display: block; max-width: max-content; }
.hero-frame { padding: 14px 22px 10px; margin-bottom: 26px; }
.hero-frame::before { top: 0; left: 0; border-right: 0; border-bottom: 0; }
.hero-frame::after { bottom: 0; right: 0; border-left: 0; border-top: 0; }
.page-hero h1 { font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 0.98; letter-spacing: -0.04em; font-weight: 700; max-width: 920px; }
.page-hero h1 .accent { color: var(--blaze); }
.page-hero p.lead { font-size: 20px; line-height: 1.5; color: var(--slate); max-width: 680px; margin-top: 22px; }

.pricing-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 48px 0 64px; }
.plan { background: var(--white); border: 1px solid var(--onyx); border-radius: 14px; padding: 32px 28px; position: relative; display: flex; flex-direction: column; box-shadow: 4px 4px 0 0 var(--onyx); }
.plan.featured { background: var(--onyx); color: var(--white); border-color: var(--onyx); box-shadow: 4px 4px 0 0 var(--blaze); }
.plan-tag { position: absolute; top: -14px; left: 28px; background: var(--blaze); color: var(--white); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 6px 12px; border-radius: 4px; border: 1px solid var(--onyx); }
.plan-name { font-size: 13px; font-weight: 600; color: var(--blaze); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 10px; }
.plan-headline { font-size: 24px; font-weight: 700; letter-spacing: -0.025em; margin-bottom: 6px; }
.plan.featured .plan-headline { color: var(--white); }
.plan-price { display: flex; align-items: baseline; gap: 6px; margin: 18px 0 4px; }
.plan-price .amt { font-size: 52px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
.plan-price .per { font-size: 14px; color: var(--slate); font-weight: 500; }
.plan.featured .plan-price .per { color: var(--slate-light); }
.plan-blurb { font-size: 14px; color: var(--slate); line-height: 1.55; margin-bottom: 22px; }
.plan.featured .plan-blurb { color: #c8c8c8; }
.plan-cta { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 18px; border-radius: 6px; font-size: 14px; font-weight: 600; text-decoration: none; border: 1px solid var(--onyx); background: var(--white); color: var(--onyx); box-shadow: 3px 3px 0 0 var(--onyx); transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease; }
.plan-cta:hover { transform: translate(1px, 1px); box-shadow: 2px 2px 0 0 var(--blaze); background: var(--blaze); color: var(--white); border-color: var(--blaze); }
.plan.featured .plan-cta { background: var(--blaze); color: var(--white); border-color: var(--blaze); box-shadow: 3px 3px 0 0 var(--white); }
.plan.featured .plan-cta:hover { background: var(--white); color: var(--onyx); border-color: var(--white); box-shadow: 2px 2px 0 0 var(--white); }
.plan-included { list-style: none; margin-top: 22px; margin-bottom: 26px; display: flex; flex-direction: column; gap: 10px; }
.plan-included li { font-size: 13px; line-height: 1.5; display: flex; gap: 9px; align-items: flex-start; }
.plan-included li::before { content: '✓'; color: var(--blaze); font-weight: 700; flex-shrink: 0; }

.compare-section { padding: 72px 0 96px; border-top: 1px solid var(--border); }
.compare-head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 32px; }
.compare-head h2 { font-size: 32px; font-weight: 700; letter-spacing: -0.03em; position: relative; padding: 2px 0 0; }
.compare-head h2::before, .compare-head h2::after { content: ''; position: absolute; width: 12px; height: 12px; border: 2px solid var(--blaze); }
.compare-head h2::before { top: 0; left: -20px; border-right: 0; border-bottom: 0; }
.compare-head h2::after { bottom: 0; right: -20px; border-left: 0; border-top: 0; }
.compare-head .desc { font-size: 14px; color: var(--slate); margin-left: auto; }

.table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 10px; }
.compare-table { width: 100%; border-collapse: collapse; background: var(--white); border: 1px solid var(--onyx); border-radius: 10px; overflow: hidden; }
.compare-table thead tr { background: #ECE8DE; border-bottom: 1px solid var(--blaze); box-shadow: inset 0 -1px 0 rgba(10, 10, 10, 0.06); }
.compare-table th { text-align: left; padding: 20px 22px; font-size: 13px; font-weight: 700; color: var(--onyx); letter-spacing: 0.06em; text-transform: uppercase; }
.compare-table th.plan-th { text-align: center; font-family: 'Sora', sans-serif; text-transform: uppercase; letter-spacing: 0.1em; font-size: 12px; color: var(--blaze); font-weight: 700; width: 18%; }
.compare-table th.plan-th.featured-col { color: var(--white); background: var(--onyx); position: relative; padding-top: 30px; }
.compare-table th.plan-th.featured-col::after { content: 'Most popular'; position: absolute; top: 9px; left: 50%; transform: translateX(-50%); font-size: 9px; color: var(--blaze); font-weight: 700; letter-spacing: 0.1em; white-space: nowrap; }
.compare-table th.plan-th .plan-th-price { display: block; font-size: 22px; font-weight: 700; color: var(--onyx); letter-spacing: -0.02em; margin-top: 6px; }
.compare-table th.plan-th.featured-col .plan-th-price { color: var(--white); }
.compare-table tbody tr { border-bottom: 1px solid var(--border); }
.compare-table tbody tr:last-child { border-bottom: none; }
.compare-table tbody tr.section-row td { background: var(--bone); font-weight: 700; font-size: 11px; color: var(--blaze); letter-spacing: 0.1em; text-transform: uppercase; padding: 12px 22px; }
.compare-table td { padding: 14px 22px; font-size: 13.5px; vertical-align: middle; }
.compare-table td.feature-name { font-weight: 500; color: var(--onyx); }
.compare-table td.plan-cell { text-align: center; color: var(--slate); font-size: 12.5px; }
.compare-table td.featured-cell { background: rgba(251, 86, 7, 0.04); font-weight: 500; color: var(--onyx); }
.check { color: var(--blaze); font-size: 18px; font-weight: 700; }
.x { color: var(--border-strong); font-size: 16px; }

.timeline-section { padding: 72px 0 96px; border-top: 1px solid var(--border); background: var(--white); }
.timeline-head { margin-bottom: 48px; }
.timeline-head h2 { font-size: 32px; font-weight: 700; letter-spacing: -0.03em; position: relative; padding: 2px 0 0; display: inline-block; }
.timeline-head h2::before, .timeline-head h2::after { content: ''; position: absolute; width: 12px; height: 12px; border: 2px solid var(--blaze); }
.timeline-head h2::before { top: 0; left: -20px; border-right: 0; border-bottom: 0; }
.timeline-head h2::after { bottom: 0; right: -20px; border-left: 0; border-top: 0; }
.timeline-head .desc { font-size: 14px; color: var(--slate); margin-top: 10px; max-width: 580px; }
.timeline-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.tl-card { background: var(--bone); border: 1px solid var(--onyx); border-radius: 12px; padding: 28px; box-shadow: 4px 4px 0 0 var(--onyx); transition: transform 0.15s, box-shadow 0.15s; }
.tl-card:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 0 var(--onyx); }
.tl-when { font-size: 12px; font-weight: 700; color: var(--blaze); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
.tl-title { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 10px; }
.tl-body { font-size: 13.5px; color: var(--slate); line-height: 1.55; }
.accel-note { margin-top: 36px; padding: 22px 26px; background: var(--onyx); color: var(--white); border-radius: 10px; display: flex; align-items: flex-start; gap: 18px; border: 1px solid var(--onyx); box-shadow: 4px 4px 0 0 var(--blaze); transition: transform 0.15s, box-shadow 0.15s; }
.accel-note:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 0 var(--blaze); }
.accel-note .label { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blaze); padding: 6px 10px; border: 1px solid var(--blaze); border-radius: 4px; white-space: nowrap; }
.accel-note .text { font-size: 14px; line-height: 1.55; color: #c8c8c8; }
.accel-note .text strong { color: var(--white); font-weight: 600; }

.ad-note { margin: 48px 0 0; padding: 28px 32px; background: var(--info-bg); border: 1px solid var(--blaze); border-radius: 10px; }
.ad-note h3 { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 8px; color: var(--scorch); }
.ad-note p { font-size: 14px; color: var(--onyx); line-height: 1.6; max-width: 720px; }

.page-cta { padding: 80px 0 96px; background: var(--onyx); color: var(--white); border-top: 0; }
.page-cta-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: center; }
.page-cta-eyebrow { font-family: 'Sora', sans-serif; font-size: 11px; color: var(--blaze); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 18px; font-weight: 700; }
.page-cta h2 { font-size: clamp(2rem, 3.75vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; margin: 0 0 20px; color: var(--white); }
.page-cta p { font-size: 17px; color: #c8c8c8; max-width: 460px; margin: 0; line-height: 1.5; }
@media (max-width: 900px) { .page-cta-grid { grid-template-columns: 1fr; gap: 32px; } }

@media (max-width: 980px) {
  .pricing-cards { grid-template-columns: 1fr; }
  .plan.featured { transform: none; }
  .timeline-grid { grid-template-columns: 1fr; }
  /* Table scrolls horizontally instead of resizing the page */
  .compare-table { min-width: 620px; }
  /* Stack the accelerated-track note vertically */
  .accel-note { flex-direction: column; gap: 14px; }
  .accel-note .label { align-self: flex-start; }
}
</style>
</BaseLayout>
