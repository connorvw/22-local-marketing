---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | 22 Local Marketing" description="The page you requested could not be found.">

<section style="min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 80px 24px;">
  <div style="max-width: 540px;">
    <div style="font-size: 80px; font-weight: 800; color: #0A0A0A; line-height: 1; margin-bottom: 16px;">404</div>
    <h1 style="font-size: 28px; font-weight: 700; margin-bottom: 16px;">Page Not Found</h1>
    <p style="color: #555; font-size: 17px; margin-bottom: 32px;">
      That page does not exist. It may have moved, or the URL may be incorrect.
    </p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/blog/" class="btn btn-secondary">Read the Blog</a>
    </div>
  </div>
</section>

</BaseLayout>
