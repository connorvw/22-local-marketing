  function close() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('quote-open');
  }

  document.addEventListener('click', e => {
    const opener = e.target.closest('[data-quote]');
    if (opener) {
      e.preventDefault();
